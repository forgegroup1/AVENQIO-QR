{
  "name": "avenqio-qr",
  "private": true,
  "version": "1.1.0",
  "homepage": "https://avenqio-qr.onrender.com",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "serve -s dist -l tcp://0.0.0.0:${PORT:-10000}",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "qr-code-styling": "^1.8.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vitest": "^3.2.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.avenqio.qr",
    "productName": "AVENQIO QR",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": ["portable"],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    }
  }
}
