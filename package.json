{
  "name": "avenqiorepence",
  "version": "0.1.0",
  "private": true,
  "description": "AvenqioPresence — Discord Rich Presence management platform for users and communities.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @avenqio/web",
    "build": "npm run build --workspace @avenqio/shared && npm run build --workspace @avenqio/web",
    "start": "node scripts/start.mjs",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:reset": "tsx scripts/db.ts reset",
    "db:policies": "tsx scripts/db.ts policies",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node tests/smoke.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "bot": "npm run dev --workspace @avenqio/discord-bot",
    "companion": "npm run dev --workspace @avenqio/companion",
    "companion:build": "npm run build --workspace @avenqio/companion",
    "companion:package": "npm run package --workspace @avenqio/companion"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.6"
  }
}
