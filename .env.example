# ─────────────────────────────────────────────────────────────────────────────
# AvenqioPresence — environment template
# Copy to `.env.local` (never commit it):   cp .env.example .env.local
# The web app, the Discord bot and the companion build scripts all read this file.
# Everything below is optional for a first local run: the app boots in
# "local development" mode with an embedded Postgres database and dev sign-in.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public origin of the dashboard. Used for OAuth redirects, companion linking and
# secure-cookie decisions. Use http://localhost:3000 locally.
APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# embedded   -> PGlite (Postgres compiled to WASM) persisted in ./.data/pglite
#               Zero setup, used for local development and the automated tests.
# postgres   -> any PostgreSQL 15+ instance, including Supabase. Set DATABASE_URL.
DB_DRIVER=embedded
DATABASE_DIR=.data/pglite
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Set to `require` for Supabase / hosted Postgres. Use `disable` only for local.
PGSSL=require

# ── Auth ─────────────────────────────────────────────────────────────────────
# Discord application (https://discord.com/developers/applications)
# OAuth2 -> Redirect: {APP_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
# Bot token — same application as above, Bot -> Reset Token
DISCORD_BOT_TOKEN=
# Optional: invite served by the "Add bot" buttons in the dashboard
DISCORD_BOT_INVITE_URL=
# Discord user IDs allowed to verify communities / access the staff area
# Comma separated. Empty = nobody can open /dashboard/admin.
AVENQIO_ADMIN_DISCORD_IDS=

# Dev sign-in lets you explore the dashboard without Discord credentials.
# It is ALWAYS disabled when NODE_ENV=production.
ALLOW_DEV_AUTH=true

# ── Discord bot ──────────────────────────────────────────────────────────────
# Optional: register slash commands in one guild for instant iteration.
# Leave empty in production so commands are registered globally.
DISCORD_DEV_GUILD_ID=
# Where the bot reaches the dashboard API (defaults to APP_URL).
BOT_API_URL=
# debug | info | warn | error
BOT_LOG_LEVEL=info

# ── Secrets ──────────────────────────────────────────────────────────────────
# 32-byte base64 key used for AES-256-GCM encryption of integration credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Shared secret for bot -> API calls (openssl rand -hex 32)
BOT_SERVICE_TOKEN=
# Bearer token used by /api/health and ops endpoints (optional)
OPS_TOKEN=

# ── Game server integrations (server-side network calls) ─────────────────────
# ER:LC uses the PRC private-server API (requires the ERLC API server pack).
ERLC_API_BASE_URL=https://api.policeroleplay.community
# Allow outbound calls to private (RFC1918) FiveM servers, local networks only.
ALLOW_PRIVATE_INTEGRATION_TARGETS=false

# ── Companion app ────────────────────────────────────────────────────────────
# Base URL baked into development companion builds.
COMPANION_API_URL=http://localhost:3000
# Discord application id used for local RPC (defaults to DISCORD_CLIENT_ID).
# The companion inlines this value at build time.
DISCORD_RPC_CLIENT_ID=
# Optional JSON update feed: {"version":"0.1.1","url":"https://…/AvenqioPresence.exe","notes":"…"}
# Without it the companion reports that automatic updates are not configured.
COMPANION_UPDATE_FEED_URL=
